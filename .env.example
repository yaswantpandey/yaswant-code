# ============================================================
# Yaswant Code LMS — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Gemini AI (optional — for AI features) ──────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ── Frontend API URL ─────────────────────────────────────────
# On InfinityFree (same domain): leave as /api (relative)
# For local dev: http://localhost:8000/api
VITE_API_BASE_URL="/api"

# ── InfinityFree MySQL Database ──────────────────────────────
# Find these in InfinityFree Client Area → Manage Account → MySQL Databases
# NOTE: On InfinityFree, DB_HOST is NOT localhost!
# It looks like: sql100.infinityfree.com, sql202.infinityfree.com, etc.
DB_HOST=sql100.infinityfree.com
DB_PORT=3306
DB_NAME=if0_12345678_lms
DB_USER=if0_12345678
DB_PASS=YourInfinityFreePasswordHere

# ── InfinityFree FTP Deployment (Local & CI/CD) ──────────────
# Found in InfinityFree Client Area → Manage Account → FTP Details
FTP_SERVER=ftpupload.net
FTP_PORT=21
FTP_USERNAME=your_infinityfree_username  # e.g. if0_12345678 or epiz_12345678
FTP_PASSWORD=your_infinityfree_password
FTP_REMOTE_DIR=yaswant.co.in/htdocs/

# ── Platform Settings ─────────────────────────────────────────
ADMIN_EMAIL=your-admin-email@yaswant.co.in
PLATFORM_URL=https://yaswant.co.in

# ── Installer Secret ──────────────────────────────────────────
# Used to protect /api/install.php
# Set this to a long, random string BEFORE deploying
# Then visit: https://yaswant.co.in/api/install.php?secret=YOUR_VALUE
INSTALL_SECRET=change_this_to_a_long_random_secret_before_deploying
