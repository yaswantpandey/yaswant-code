# ============================================================
# Yaswant Code LMS — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Gemini AI (optional — for AI features) ──────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ── Frontend API URL ─────────────────────────────────────────
# On Hostinger (same domain): leave as /api (relative)
# For local dev: http://localhost:8000/api
VITE_API_BASE_URL="/api"

# ── Hostinger MySQL Database ──────────────────────────────────
# Find these in hPanel → Databases → MySQL Databases
# DB_HOST is almost always "localhost" on Hostinger shared hosting
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_lms
DB_USER=u123456789_user
DB_PASS=YourSecureDatabasePasswordHere

# ── Platform Settings ─────────────────────────────────────────
ADMIN_EMAIL=your-admin-email@yourdomain.com
PLATFORM_URL=https://yourdomain.com

# ── Installer Secret ──────────────────────────────────────────
# Used to protect /api/install.php
# Set this to a long, random string BEFORE deploying
# Then visit: https://yourdomain.com/api/install.php?secret=YOUR_VALUE
INSTALL_SECRET=change_this_to_a_long_random_secret_before_deploying
