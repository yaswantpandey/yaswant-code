rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles: users can read & write their own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Courses & learning material: public read, admin write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Enrollments: users can read and write their own enrollments
    match /enrollments/{enrollmentId} {
      allow read, write: if request.auth != null;
    }

    // Study notes & developer tools: public read, authenticated write
    match /study_notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /developer_tools/{toolId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
