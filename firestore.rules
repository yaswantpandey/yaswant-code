rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.role == 'admin'; }

    // User profiles: owner-only access; role can never be self-assigned or changed by the client
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', 'student') == 'student';
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', 'student') == resource.data.get('role', 'student');
      allow delete: if isAdmin();

      // Private subcollections (notes, enrollments, ...): owner only
      match /{sub=**} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Courses & learning material: public read, admin write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Top-level enrollments: owner only
    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin())
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Project submissions: community-visible to signed-in users, writable only by the author
    match /projectSubmissions/{submissionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Study notes & developer tools: public read, admin write
    match /study_notes/{noteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /developer_tools/{toolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else: deny by default
  }
}
