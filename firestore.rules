rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ecotech.internship@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['student', 'instructor', 'admin'];
    }

    function isValidNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 50000;
    }

    function isValidProjectSubmission(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.projectId is string && data.projectId.size() <= 100 &&
             data.githubUrl is string && data.githubUrl.size() <= 300;
    }

    function isValidEnrollment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.courseId is string && data.courseId.size() <= 100 &&
             data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().id == userId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'title', 'avatar']);
      allow delete: if isAdmin();

      // Personal study notes
      match /notes/{noteId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming());
        allow update: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming()) &&
                        incoming().userId == userId &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'updatedAt', 'tags']);
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Course Enrollments
      match /enrollments/{enrollmentId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(enrollmentId) && isValidEnrollment(incoming());
        allow update: if isOwner(userId) && isValidId(enrollmentId) && isValidEnrollment(incoming()) &&
                        incoming().userId == userId &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['progressPercent', 'currentLessonId', 'updatedAt']);
        allow delete: if isAdmin();
      }
    }

    // Capstone Project Submissions
    match /projectSubmissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(submissionId) && isValidProjectSubmission(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) &&
                      isValidProjectSubmission(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['githubUrl', 'liveUrl', 'notes', 'updatedAt']);
      allow delete: if isAdmin();
    }
  }
}
